# ── Servidor ──────────────────────────────────────────────────
PORT=3000

# ── Base de datos (PostgreSQL) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aiagentbuilder
DB_USER=postgres
DB_PASSWORD=password1234
# SSL: ponlo en 'false' en local (PostgreSQL sin SSL). En Vercel no añadas esta variable
# (sin ella el código activa SSL automáticamente, necesario para Neon/Supabase)
DB_SSL=false

# ── JWT ───────────────────────────────────────────────────────
# Genera un valor seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=mi_secreto_super_seguro_cambiar_en_produccion

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=tu_key_aqui

# ── CORS ─────────────────────────────────────────────────────
# En producción, pon la URL de tu frontend en Vercel.
# Para múltiples orígenes separa con comas: https://app.vercel.app,https://custom-domain.com
# En local incluye también el widget (localhost:5173) para que la preview funcione:
FRONTEND_URL=http://localhost:4200,http://localhost:5173
